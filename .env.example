# Copy to .env and fill in. .env is git-ignored and must never be committed.
# In GitHub Actions or any hosted runner, set these as repository secrets and
# write them into .env at run time -- do not paste them into a workflow file.

# Slack bot "RiseRidge Sales" (xoxb-...). Scopes: chat:write, files:write,
# channels:history, groups:history, channels:read, groups:read, users:read,
# reactions:read, reactions:write.
SLACK_BOT_TOKEN=

# The private #sales-pipeline channel the bot reads booked appointments from.
SALES_PIPELINE_CHANNEL=C09PLHVBHRC

# The bot's own user id, used to skip its own messages.
SLACK_BOT_USER_ID=

# SearchAtlas API key, sent as the X-API-Key header. Previously read from the
# sibling project's .env; now that the client is vendored, set it here.
SEARCHATLAS_API_KEY=

# --- AI visibility probe ---------------------------------------------------
# At least one is needed for the AI section to render. An engine with no key is
# omitted from the report, never scored zero. Endpoint and model default per
# provider and can be overridden with RR_OPENAI_ENDPOINT, RR_OPENAI_MODEL and
# the matching RR_PERPLEXITY_* / RR_GEMINI_* names.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# --- automation ------------------------------------------------------------
# Artefacts are delivered into the lead's thread in SALES_PIPELINE_CHANNEL,
# which is private and internal -- the prospect is not in it. Delivery is
# controlled by run_pipeline.py --post; no separate channel is needed.
#
# RR_POSTING_ARMED is a second switch that post.py requires only for a channel
# the prospect CAN see. Nothing in this pipeline targets one, so it is unset.
RR_POSTING_ARMED=

# Chrome override for the PDF renderer. Only needed off Windows.
RR_CHROME=
RR_CHROME_FLAGS=

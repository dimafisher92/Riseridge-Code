# Copy to .env and fill in. .env is git-ignored and must never be committed.
# In GitHub Actions or any hosted runner, set these as repository secrets and
# write them into .env at run time -- do not paste them into a workflow file.

# Slack bot "RiseRidge Sales" (xoxb-...). Scopes: chat:write, files:write,
# channels:history, groups:history, channels:read, groups:read, users:read,
# reactions:read, reactions:write.
SLACK_BOT_TOKEN=

# The private #sales-pipeline channel the bot reads booked appointments from.
SALES_PIPELINE_CHANNEL=C09PLHVBHRC

# The bot's own user id, used to skip its own messages.
SLACK_BOT_USER_ID=

# SearchAtlas API key, sent as the X-API-Key header. Previously read from the
# sibling project's .env; now that the client is vendored, set it here.
SEARCHATLAS_API_KEY=
